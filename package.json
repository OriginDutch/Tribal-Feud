{
  "name": "tribal-feud",
  "private": true,
  "version": "0.1.0",
  "description": "Singleplayer Tribal Wars-style strategy game against big-brain bots",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "npx --yes esbuild tools/bench/bench.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/bench.mjs --log-level=error && node node_modules/.cache/bench.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OriginDutch/tribal-feud.git"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "fake-indexeddb": "^6.2.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@preact/signals": "^2.11.3",
    "preact": "^11.0.2"
  }
}

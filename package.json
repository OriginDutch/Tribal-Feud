{
  "name": "tribal-feud",
  "private": true,
  "version": "0.1.0",
  "description": "Singleplayer Tribal Wars-style strategy game against big-brain bots",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "npx --yes esbuild tools/bench/bench.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/bench.mjs --log-level=error && node node_modules/.cache/bench.mjs",
    "fingerprint": "npx --yes esbuild tools/bench/fingerprint.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/fingerprint.mjs --log-level=error && node node_modules/.cache/fingerprint.mjs",
    "growth": "npx --yes esbuild tools/bench/growth.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/growth.mjs --log-level=error && node node_modules/.cache/growth.mjs",
    "stats": "npx --yes esbuild tools/bench/stats.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/stats.mjs --log-level=error && node node_modules/.cache/stats.mjs",
    "smoke": "node tools/smoke/smoke.mjs",
    "realism": "npx --yes esbuild tools/bench/realism.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/realism.mjs --log-level=error && node node_modules/.cache/realism.mjs",
    "pace": "npx --yes esbuild tools/bench/pace.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/pace.mjs --log-level=error && node node_modules/.cache/pace.mjs",
    "curve": "npx --yes esbuild tools/bench/curve.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/curve.mjs --log-level=error && node node_modules/.cache/curve.mjs",
    "armies": "npx --yes esbuild tools/bench/armies.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/armies.mjs --log-level=error && node node_modules/.cache/armies.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OriginDutch/tribal-feud.git"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "fake-indexeddb": "^6.2.6",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@preact/signals": "^2.11.3",
    "preact": "^11.0.2"
  }
}

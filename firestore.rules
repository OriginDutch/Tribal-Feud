rules_version = '2';
// Tribal Feud: every account sees and writes only its own data. The admin may list the accounts
// (email, created, last seen), never anyone's worlds. The admin address is also in src/cloud/config.ts. Everything else is refused.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() {
      return signedIn() && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == 'marcel_19-95@hotmail.com';
    }

    match /users/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['email', 'created', 'lastSeen'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.created == request.time
        && request.resource.data.lastSeen == request.time;
      allow update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['email', 'created', 'lastSeen'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.created == resource.data.created
        && request.resource.data.lastSeen == request.time;

      // a world in the cloud: slots 1-3 only, so an account holds at most three
      match /worlds/{slot} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && slot in ['1', '2', '3']
          && request.resource.data.keys().hasOnly(['key', 'name', 'savedAt', 'gameTime', 'version', 'size', 'chunks'])
          && request.resource.data.key is string && request.resource.data.key.size() <= 40
          && request.resource.data.name is string && request.resource.data.name.size() <= 100
          && request.resource.data.savedAt is int
          && request.resource.data.gameTime is number
          && request.resource.data.version is int
          && request.resource.data.size is int && request.resource.data.size <= 5600000
          && request.resource.data.chunks is int && request.resource.data.chunks >= 1 && request.resource.data.chunks <= 8;

        // the gzipped save in pieces of at most 700 KB, numbered 0-7
        match /chunks/{n} {
          allow read, delete: if isOwner(uid);
          allow create, update: if isOwner(uid)
            && slot in ['1', '2', '3']
            && n in ['0', '1', '2', '3', '4', '5', '6', '7']
            && request.resource.data.keys().hasOnly(['data'])
            && request.resource.data.data is bytes
            && request.resource.data.data.size() <= 700000;
        }
      }
    }
  }
}
